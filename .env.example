# ==============================================================================
# KALYX PRODUCTION CONFIGURATION SPECIFICATION (.env.example)
# ==============================================================================
# Copy this template to .env and configure for your target environment.
# In production (KALYX_ENV=production), the application enforces strict fail-closed
# startup validations.

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Environment mode: "demo" (local evaluation) or "production" (enterprise deployment).
# When "production", SQLite is rejected, policy secrets must not use demo defaults,
# and fail-closed authentication is required.
KALYX_ENV=production

# ------------------------------------------------------------------------------
# 2. PERSISTENCE LAYER
# ------------------------------------------------------------------------------
# In production: KALYX_DATABASE_URL is authoritative and MUST be a PostgreSQL URL.
# SQLite is strictly forbidden in production.
KALYX_DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/kalyx_prod

# In demo/development only: SQLite database path (default: kalyx.db).
# Ignored when KALYX_DATABASE_URL is provided.
# KALYX_DB=kalyx.db

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# Mandatory in production: High-entropy signing secret used for:
# - Cryptographic HMAC policy authorization tokens
# - Bearer identity tokens
# Must be at least 32 characters and NOT contain demo placeholders.
KALYX_POLICY_SECRET=generate_a_random_32_plus_character_secret_here

# Administrative operator API key for emergency controls (pause, resume, etc.).
# Clients present this via the `X-API-Key` HTTP header.
KALYX_OPERATOR_KEY=generate_a_random_operator_api_key_here

# Whether operator actions require the operator key (always enforced in production).
KALYX_REQUIRE_OPERATOR_AUTH=true

# ------------------------------------------------------------------------------
# 4. IDENTITY & ACCESS CONTROL (RBAC)
# ------------------------------------------------------------------------------
# Identity mode: "production" (enforces Bearer token verification) or "demo" (allows X-Principal-ID).
# When KALYX_ENV=production, this defaults to production fail-closed semantics.
KALYX_IDENTITY_AUTH=production

# ------------------------------------------------------------------------------
# 5. NETWORKING & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins for browser UI clients.
KALYX_CORS_ORIGINS=https://YOUR-KALYX-DOMAIN

# ------------------------------------------------------------------------------
# 6. TRAFFIC LIMITS & DEFENSE-IN-DEPTH
# ------------------------------------------------------------------------------
# Maximum allowable HTTP request body size in bytes (default: 1048576 = 1 MB).
KALYX_MAX_REQUEST_BYTES=1048576

# Enable in-memory sliding-window rate limiting.
KALYX_RATE_LIMIT_ENABLED=true

# Mutation rate limit (POST, PUT, DELETE, PATCH) in requests per minute per principal/IP.
KALYX_RATE_LIMIT_MUTATIONS_PER_MIN=60

# Read rate limit (GET) in requests per minute per principal/IP.
KALYX_RATE_LIMIT_READS_PER_MIN=300

# ------------------------------------------------------------------------------
# 7. BLOCKCHAIN SETTLEMENT & EXECUTION (PHASE 12)
# ------------------------------------------------------------------------------
# Enable real EVM blockchain settlement (default: false = simulated provider).
# Real blockchain execution is opt-in and testnet-only.
KALYX_BLOCKCHAIN_ENABLED=false

# JSON-RPC endpoint URL for target testnet (e.g. Ethereum Sepolia).
# Mandatory when KALYX_BLOCKCHAIN_ENABLED=true.
KALYX_BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Target EVM chain ID (default: 11155111 for Ethereum Sepolia).
KALYX_BLOCKCHAIN_CHAIN_ID=11155111

# Target network name (default: sepolia).
KALYX_BLOCKCHAIN_NETWORK=sepolia

# 32-byte hex private key for isolated signing boundary.
# Mandatory when KALYX_BLOCKCHAIN_ENABLED=true.
# MUST be a dedicated testnet wallet. NEVER use mainnet funds or keys.
# KALYX_BLOCKCHAIN_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Comma-separated list of pre-approved recipient 0x addresses for policy allowlisting.
# KALYX_BLOCKCHAIN_RECIPIENT_ALLOWLIST=0x0000000000000000000000000000000000000001

# ------------------------------------------------------------------------------
# 8. STRUCTURED OBSERVABILITY & AUDITING
# ------------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR.
KALYX_LOG_LEVEL=INFO

# Logging format: "json" (structured JSON for log aggregators) or "text" (human readable).
KALYX_LOG_FORMAT=json


# ------------------------------------------------------------------------------
# 9. PHASE 17 ORBIO GATEWAY
# ------------------------------------------------------------------------------
# Optional for simulated/demo execution. Required for live Orbio execution.
# Keep this secret server-side; never expose it to the browser.
# ORBIO_API_KEY=
# Production Orbio gateway base. Override only if using a different compatible endpoint.
ORBIO_GATEWAY_BASE=https://api.orbio.so/api/v1
ORBIO_MODEL=anthropic/claude-fable-5.1
# In production this should be false. Demo/CI can use true for deterministic fallback.
KALYX_ORBIO_ALLOW_SIMULATED_FALLBACK=false

# ------------------------------------------------------------------------------
# 10. PHASE 17 RECEIPT VERIFICATION
# ------------------------------------------------------------------------------
# High-entropy secret used to authenticate work-deliverable receipts.
# Required whenever the Phase 17 B2B/productive-work path is used.
KALYX_RECEIPT_SECRET_KEY=generate_another_random_32_plus_character_secret_here


# ------------------------------------------------------------------------------
# 11. PHASE 18 CREDIT COLLATERAL VAULT
# ------------------------------------------------------------------------------
# disabled = normal Kalyx operation; simulated = deterministic demo; live = real
# on-chain CREDIT collateral. Keep disabled until the vault has been deployed
# and the Foundry suite + testnet rehearsal are green.
KALYX_COLLATERAL_MODE=disabled
# Robinhood Chain mainnet · chain ID 4663 (official Orbio CREDIT deployment)
# Keep this value fixed unless the deployment is intentionally changed.
KALYX_COLLATERAL_TOKEN_ADDRESS=0xe33322Da1380e61E5AE5DFb21e7F62924c73004C
# Required only when KALYX_COLLATERAL_MODE=live.
# KALYX_COLLATERAL_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# KALYX_COLLATERAL_VAULT_ADDRESS=0x...

# Settlement signer: owns the deployed vault and can release/forfeit locked positions.
# Pledger signer: wallet that actually owns CREDIT and signs approve()+lock().
# For a one-wallet hackathon rehearsal these may be the same key. Never commit keys.
# KALYX_COLLATERAL_OWNER_KEY=0x...
# KALYX_COLLATERAL_PLEDGER_KEY=0x...
