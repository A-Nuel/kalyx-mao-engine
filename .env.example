# Kalyx runtime configuration
# demo (default) keeps operator controls available without a key.
# production requires KALYX_OPERATOR_KEY and PostgreSQL.
KALYX_ENV=demo

# SQLite path for local/demo/tests (default)
KALYX_DB=data/kalyx.db

# Production PostgreSQL (required when KALYX_ENV=production)
# Example: postgresql://kalyx:secret@db:5432/kalyx
KALYX_DATABASE_URL=

# Optional pool bounds for PostgreSQL
KALYX_DB_POOL_MIN=1
KALYX_DB_POOL_MAX=10

# Comma-separated browser origins. Leave unset for demo/local use.
# Example: https://kalyx.example.com,https://admin.example.com
KALYX_CORS_ORIGINS=

# Required when KALYX_ENV=production. Strong random secret recommended.
KALYX_OPERATOR_KEY=
